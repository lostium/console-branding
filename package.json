{
  "name": "@lostium/console-branding",
  "version": "1.1.0",
  "description": "Banner de marca de Lostium Innovation Studio para la consola del navegador, en español e inglés.",
  "keywords": [
    "lostium",
    "console",
    "branding",
    "banner",
    "devtools",
    "easter-egg"
  ],
  "license": "MIT",
  "author": "Lostium Innovation Studio <found@lostium.com> (https://lostium.com)",
  "homepage": "https://github.com/lostium/console-branding#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lostium/console-branding.git"
  },
  "bugs": {
    "url": "https://github.com/lostium/console-branding/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "default": "./dist/angular.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm build",
    "release": "./scripts/release.sh"
  },
  "peerDependencies": {
    "@angular/core": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "jsdom": "^31.0.1",
    "rxjs": "^7.8.2",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
